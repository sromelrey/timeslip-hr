### Admin Login (establish session cookie)
# @name adminLogin
POST {{API_BASE_URL}}/auth/login
Content-Type: application/json

{
  "email": "{{TEST_EMPLOYEE}}",
  "password": "{{TEST_USER_PASSWORD}}"
}

### List all timesheets
GET {{API_BASE_URL}}/timesheets
Authorization: Bearer {{adminLogin.accessToken}}

### Generate timesheets for Pay Period 1
POST {{API_BASE_URL}}/timesheets/generate
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{
  "payPeriodId": 1
}

### Get specific timesheet (replace :id with actual ID)
GET {{API_BASE_URL}}/timesheets/1
Authorization: Bearer {{adminLogin.accessToken}}

### Populate timesheet days (aggregate time events)
POST {{API_BASE_URL}}/timesheets/1/populate
Authorization: Bearer {{adminLogin.accessToken}}

### Update timesheet status to REVIEWED
PATCH {{API_BASE_URL}}/timesheets/1/status
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{
  "status": "REVIEWED"
}

### Update timesheet status to APPROVED
PATCH {{API_BASE_URL}}/timesheets/1/status
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{
  "status": "APPROVED"
}

### Get raw time events for a timesheet
GET {{API_BASE_URL}}/timesheets/1/events
Authorization: Bearer {{adminLogin.accessToken}}

### Create adjustment for a timesheet day (add 30 mins regular time)
POST {{API_BASE_URL}}/timesheets/days/1/adjustments
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{
  "field": "REGULAR",
  "mode": "DELTA",
  "deltaMinutes": 30,
  "reason": "Employee worked during lunch, adding 30 minutes to compensate."
}

### Create adjustment for a timesheet day (override break time)
POST {{API_BASE_URL}}/timesheets/days/1/adjustments
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{
  "field": "BREAK",
  "mode": "OVERRIDE",
  "overrideMinutes": 60,
  "reason": "Correcting break time to reflect actual 1 hour break taken."
}

### Get adjustment history for a timesheet day
GET {{API_BASE_URL}}/timesheets/days/1/adjustments
Authorization: Bearer {{adminLogin.accessToken}}
